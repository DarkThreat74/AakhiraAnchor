# ─── Database (Neon) ───
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/waqt?sslmode=require

# ─── Auth ───
SESSION_SECRET=generate-with-openssl-rand-base64-32

# ─── App ───
APP_URL=http://localhost:3000

# ─── Cron ───
CRON_SECRET=generate-a-long-random-string

# ─── AlAdhan API (free, no key needed) ───
ALADHAN_BASE_URL=https://api.aladhan.com/v1

# ─── Twilio (SMS, opt-in) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Stripe (subscriptions) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Web Push (VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── LLM (OpenRouter, for NL event entry) ───
OPENROUTER_API_KEY=

# ─── Cloudflare Turnstile (bot protection) ───
# Get both keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# Set NEXT_PUBLIC_TURNSTILE_ENABLED=true ONLY when BOTH keys are configured.
# When false, signup uses playcaptcha (claw machine) as fallback.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_ENABLED=false

# ─── Client-safe (NEXT_PUBLIC_ prefix) ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ALADHAN_BASE_URL=https://api.aladhan.com/v1
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
